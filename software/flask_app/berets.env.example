# BERETS — пример конфигурации Raspberry Pi.
# Не подставляйте значения с многоточиями: неизвестные параметры оставляйте
# выключенными до фактического измерения.

# Обязательные секреты. Установщик создаёт случайные значения, если их нет.
# Не используйте эти примеры как реальные значения.
# BERETS_SECRET_KEY=
# BERETS_SYSTEM_PASSWORD=
# Защита браузерных POST/PUT/PATCH/DELETE включена по умолчанию.
# BERETS_CSRF_ENABLED=1
# Защита от перебора: 5 ошибок за 5 минут блокируют вход на 5 минут.
# BERETS_LOGIN_ATTEMPTS=5
# BERETS_LOGIN_WINDOW_SECONDS=300
# BERETS_LOGIN_LOCK_SECONDS=300
# Включать Secure-cookie только после настройки HTTPS reverse proxy.
# BERETS_HTTPS=0

# Безопасный демонстрационный режим. Не меняйте значения на 1 до поузловой
# проверки конкретной сборки и аппаратной аварийной остановки.
BERETS_REAL_MANIPULATOR=0
BERETS_AUTO_CONTAINER_EXCHANGE=0
BERETS_CONTAINER_EXCHANGE_SENSOR_CONFIRM_SECONDS=0.3
BERETS_SERVO_PORT=/dev/ttyAMA0
# В текущей TX-only схеме команды осей манипулятора передаются повторно.
BERETS_SERVO_COMMAND_REPEATS=2
BERETS_SERVO_REPEAT_DELAY_SECONDS=0.035
# Только ручное управление: логическая команда ID16=613 передаётся как 570.
# HOME, просмотр маршрутных точек и автоматический цикл используют исходные
# сохранённые значения без этой компенсации.
BERETS_MANUAL_WRIST_COMMAND_OFFSET=-43
# Только непрерывное ручное перетаскивание; маршруты используют время точки.
BERETS_MANUAL_LIVE_MOVE_MS=1600

# Датчики контейнеров уже проверены отдельно.
BERETS_REAL_CONTAINER_SENSORS=0

# Автозапуск камеры и модели выключен в публичной конфигурации.
BERETS_AUTO_START_VISION=0

# Включать только после теста конкретного MOSFET:
# BERETS_REAL_CONVEYOR=1
# BERETS_CONVEYOR_ACTIVE_HIGH=1

# Включать только после установки NC-концевиков и калибровки:
# BERETS_REAL_RAIL=1
# Включать только после отдельного теста TMC2209/мотора, проверки MIN/MAX,
# успешного HOME на малой скорости и подтверждения хода 0–347 мм:
# BERETS_RAIL_COMMISSIONED=1
# BERETS_RAIL_STEPS_PER_MM=40
# Рабочее перемещение каретки: 347 мм = 13 880 STEP. Ноль — у жёлтого контейнера.
# Начальный предел; после первого запуска изменяется в разделе «Настройки».
# BERETS_RAIL_SPEED_STEPS_S=2000
# BERETS_RAIL_HOME_DIR=-1
# BERETS_RAIL_DIR_INVERTED=0

# Включать только после калибровки всех шести положений заслонок:
# BERETS_REAL_CYCLE=1
# BERETS_GATE_OPEN_3=
# BERETS_GATE_CLOSED_3=
# BERETS_GATE_OPEN_4=
# BERETS_GATE_CLOSED_4=
# BERETS_GATE_OPEN_5=
# BERETS_GATE_CLOSED_5=
# BERETS_GATE_HOLD_SECONDS=0.50
# Независимый дозатор: t=0 -> 200, t=2.5 -> 500, t=6.0 -> повтор.
# BERETS_REAL_DISPENSER=1
# BERETS_DISPENSER_FEED_POSITION=200
# BERETS_DISPENSER_HOME_POSITION=500
# BERETS_DISPENSER_CYCLE_SECONDS=6.0
# BERETS_DISPENSER_RETURN_AT_SECONDS=2.5
# BERETS_DISPENSER_MOVE_TIME_MS=1600
# Автоматические заслонки: максимально быстрое движение и дополнительное
# удержание после попадания яблока в верхнюю зону сброса.
# BERETS_GATE_MOVE_TIME_MS=100
# BERETS_GATE_RELEASE_HOLD_SECONDS=0.5
# Время после выхода яблока из зоны сброса, пока оно докатывается в контейнер.
BERETS_GATE_DROP_SETTLE_SECONDS=1.5
# Окно привязки нового YOLO track ID к тому же физическому яблоку.
BERETS_GATE_REID_SECONDS=3.0
# Дополнительная задержка остановки больше не нужна: яблоко падает сразу.
BERETS_FULL_CONTAINER_STOP_DELAY_SECONDS=0
# BERETS_CONTAINER_REMOVAL_SECONDS=3.0
# Контейнер считается возвращённым после 0.3 с непрерывного сигнала.
# Это не даёт дребезгу концевика случайно сбросить таймер отсутствия.
BERETS_CONTAINER_RETURN_CONFIRM_SECONDS=0.3
# BERETS_VISION_DISPLAY_CONFIDENCE=0.50
# BERETS_SWAP_RED_GREEN=0

BERETS_MIN_CONFIDENCE=0.65
# Задайте собственную длинную строку перед доступом к API зрения по сети.
# BERETS_VISION_TOKEN=
# BERETS_YOLO_MODEL=/opt/berets/models/apple_sorting_best.pt
# BERETS_CAMERA_INDEX=0
# BERETS_VISION_DISPLAY=1
# BERETS_VISION_STREAM_FPS=15
# BERETS_VISION_JPEG_QUALITY=70
# BERETS_VISION_ANNOTATED=1
# BERETS_AUTO_START_VISION=1
# BERETS_VISION_PYTHON=/opt/berets/software/apple_sorting/.venv/bin/python
# BERETS_YOLO_IMGSZ=320
# BERETS_PROCESS_EVERY_N_FRAMES=2
# BERETS_VISION_TRACK_CONFIDENCE=0.35
# BERETS_YOLO_TRACKER=bytetrack.yaml
