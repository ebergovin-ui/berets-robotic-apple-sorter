[Unit]
Description=BERETS Flask control panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=berets
WorkingDirectory=/opt/berets/software/flask_app
EnvironmentFile=-/opt/berets/software/flask_app/berets.env
ExecStart=/opt/berets/software/flask_app/.venv/bin/python /opt/berets/software/flask_app/pr3.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
